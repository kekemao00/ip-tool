<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <TargetFramework>net48</TargetFramework>
    <UseWindowsForms>true</UseWindowsForms>
    <RootNamespace>IP_UpdateTest</RootNamespace>
    <AssemblyName>IP_UpdateTest</AssemblyName>
    <ApplicationIcon>app.ico</ApplicationIcon>
    <ApplicationManifest>Properties\app.manifest</ApplicationManifest>
    <!-- 调用 netsh 等系统工具时避免被重定向到 SysWOW64 -->
    <PlatformTarget>AnyCPU</PlatformTarget>
    <Prefer32Bit>false</Prefer32Bit>
  </PropertyGroup>

  <!-- 程序集信息（由 SDK 生成；ComVisible/Guid 保留在 Properties\AssemblyInfo.cs） -->
  <PropertyGroup>
    <Version>2.0.0</Version>
    <AssemblyTitle>IP Tool</AssemblyTitle>
    <Product>IP Tool</Product>
    <Description>Windows 网络配置工具</Description>
    <Copyright>Copyright © 2016-2026</Copyright>
  </PropertyGroup>

  <ItemGroup>
    <Reference Include="System.Management" />
    <Reference Include="System.Runtime.Serialization" />
  </ItemGroup>

  <ItemGroup>
    <EmbeddedResource Include="app.ico" LogicalName="IP_UpdateTest.app.ico" />
  </ItemGroup>

</Project>
